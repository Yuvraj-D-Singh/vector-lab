# Ollama endpoint. For Render, use the HTTPS URL printed by cloudflared.
OLLAMA_URL=http://127.0.0.1:11434
# Optional HTTP Basic Auth for an Ollama endpoint protected by the included Caddy config.
# Configure both values together; never commit real credentials.
# OLLAMA_BASIC_AUTH_USERNAME=
# OLLAMA_BASIC_AUTH_PASSWORD=
# Optional: put persisted vectors and document chunks elsewhere.
# VECTOR_ATLAS_DATA=C:\\VectorAtlasData
